{
  "manifest_version": 3,
  "name": "Cushman & Wakefield Listing Scraper",
  "version": "0.1.0",
  "description": "Scrapes Cushman & Wakefield lease listings and brochure PDFs into a tracked Excel export. Personal research use only.",

  "permissions": ["storage", "downloads", "tabs", "unlimitedStorage"],

  "host_permissions": [
    "https://www.cushmanwakefield.com/*",
    "https://assets.cushmanwakefield.com/*",
    "https://api.anthropic.com/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CW Listing Scraper"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "options_page": "settings/settings.html",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
